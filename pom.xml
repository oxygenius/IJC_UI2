<project xmlns="http://maven.apache.org/POM/4.0.0" 
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>nl.amity</groupId>
  <artifactId>ijc_ui</artifactId>
  <version>2.0.1.9</version>
  <packaging>jar</packaging>

  <name>IJC_UI</name>
  <description>Interne Jeugd Competitie UI</description> 

  <repositories>
    <repository>
      <id>objectdb</id>
      <name>ObjectDB Repository</name>
      <url>https://m2.objectdb.com</url>
    </repository>
  </repositories>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.apache.groovy</groupId>
      <artifactId>groovy</artifactId>
      <version>4.0.24</version>
    </dependency>
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>2.11.0</version>
    </dependency>
    <dependency>
      <groupId>org.jfree</groupId>
      <artifactId>jfreechart</artifactId>
      <version>1.5.6</version>
    </dependency>
    <dependency>
      <groupId>org.jfree</groupId>
      <artifactId>jcommon</artifactId>
      <version>1.0.24</version>
    </dependency>
    <dependency>
      <groupId>nz.ac.waikato.cms.weka</groupId>
      <artifactId>weka-stable</artifactId>
      <version>3.8.6</version>
    </dependency>
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi</artifactId>
      <version>5.4.1</version>
    </dependency>
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <version>5.4.1</version>
    </dependency>
    <dependency>
      <groupId>com.objectdb</groupId>
      <artifactId>objectdb</artifactId>
      <version>2.9.0</version>
    </dependency>
    <dependency>
      <groupId>org.json</groupId>
      <artifactId>json</artifactId>
      <version>20240303</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <!-- version.properties krijgt het versienummer uit deze pom (enige bron voor de versie) -->
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>version.properties</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>version.properties</exclude>
        </excludes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <source>${maven.compiler.source}</source>
          <target>${maven.compiler.target}</target>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.3.0</version>
        <configuration>
          <archive>
            <manifest>
              <addClasspath>true</addClasspath>
              <mainClass>nl.amity.ijc_ui.IJC_Wedstrijden</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
         <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>nl.amity.ijc_ui.IJC_Wedstrijden</mainClass>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <version>3.1.0</version>
            <executions>
              <execution>
                <id>create-release-bundle</id>
                <phase>package</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <target>
                    <!-- Ensure Release directory exists -->
                    <mkdir dir="${project.basedir}/Release"/>

                    <!-- Remove jars/zips of previous versions (published on GitHub Releases).
                         Only build output is removed: configuratie.json, status.json, keystore.ks,
                         db/ and log files in Release/ are left alone. A jar that is in use is skipped. -->
                    <delete failonerror="false" quiet="true">
                      <fileset dir="${project.basedir}/Release">
                        <include name="${project.artifactId}-*.jar"/>
                        <include name="${project.artifactId}-*.zip"/>
                        <include name="run.cmd"/>
                      </fileset>
                    </delete>

                    <!-- Copy the shaded executable JAR -->
                    <copy file="${project.build.directory}/${project.build.finalName}.jar" 
                          tofile="${project.basedir}/Release/${project.artifactId}-${project.version}.jar"/>

                    <!-- Copy templates if present: Leeg.docx (intekenlijst) and Template.xlsx (Excel-export) -->
                    <copy file="${project.basedir}/Leeg.docx"
                          todir="${project.basedir}/Release"
                          failonerror="false"/>
                    <copy file="${project.basedir}/Template.xlsx"
                          todir="${project.basedir}/Release"
                          failonerror="false" quiet="true"/>

                    <!-- Generate release metadata file with Java & version details -->
                    <echo file="${project.basedir}/Release/release-info.txt" append="false">Release Version: ${project.version}
Artifact: ${project.artifactId}-${project.version}.jar
Target Java Version: Java ${maven.compiler.target} (Minimum required JRE: ${maven.compiler.target}+)
Build Date: ${maven.build.timestamp}
Main Class: nl.amity.ijc_ui.IJC_Wedstrijden
</echo>

                    <!-- Generate Windows launcher script -->
                    <echo file="${project.basedir}/Release/IJC_UI.cmd" append="false">@echo off
rem Launcher for ${project.name} v${project.version} (Requires Java ${maven.compiler.target}+)
start javaw -jar "%~dp0${project.artifactId}-${project.version}.jar"
</echo>

                    <!-- Create distribution zip archive with all release artifacts -->
                    <zip destfile="${project.basedir}/Release/${project.artifactId}-${project.version}.zip">
                      <fileset dir="${project.basedir}/Release">
                        <include name="${project.artifactId}-${project.version}.jar"/>
                        <include name="release-info.txt"/>
                        <include name="IJC_UI.cmd"/>
                        <include name="Leeg.docx"/>
                        <include name="Template.xlsx"/>
                      </fileset>
                      <!-- configuratie.json en status.json bevatten clubgegevens en worden niet meegeleverd -->
                      <fileset dir="${project.basedir}">
                        <include name="logging.properties"/>
                        <include name="README.md"/>
                        <include name="CHANGELOG.md"/>
                      </fileset>
                    </zip>

                    <!-- Controle: release mag nooit club- of spelersgegevens bevatten (de repository is openbaar) -->
                    <fail message="Release bevat club- of spelersgegevens (configuratie.json, status.json, keystore, spelersdatabase of rondemap). Release afgebroken.">
                      <condition>
                        <or>
                          <resourcecount when="greater" count="0">
                            <zipfileset src="${project.basedir}/Release/${project.artifactId}-${project.version}.zip"
                                        includes="**/configuratie*.json **/status*.json **/*.ks **/*.odb **/db/** **/R*-*/**"/>
                          </resourcecount>
                          <resourcecount when="greater" count="0">
                            <zipfileset src="${project.build.directory}/${project.build.finalName}.jar"
                                        includes="configuratie*.json status*.json **/*.ks **/*.odb db/**"/>
                          </resourcecount>
                        </or>
                      </condition>
                    </fail>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- Windows-installer: mvn -Prelease,installer package
         1. jpackage maakt target/app-image/IJC_UI2 (IJC_UI2.exe met ingebouwde Java-runtime)
         2. Inno Setup maakt daarvan Release/IJC_UI2-setup-<versie>.exe
         Vereist een JDK 17+ (jpackage) en Inno Setup 6 (pad via -Discc.exe=...). -->
    <profile>
      <id>installer</id>
      <properties>
        <iscc.exe>C:/Program Files (x86)/Inno Setup 6/ISCC.exe</iscc.exe>
        <jpackage.modules>java.base,java.compiler,java.desktop,java.instrument,java.management,java.naming,java.net.http,java.prefs,java.rmi,java.scripting,java.security.jgss,java.sql,java.xml.crypto,jdk.accessibility,jdk.charsets,jdk.crypto.ec,jdk.localedata,jdk.unsupported,jdk.zipfs</jpackage.modules>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <version>3.1.0</version>
            <executions>
              <execution>
                <id>create-windows-installer</id>
                <phase>package</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <target>
                    <!-- jpackage wil een invoermap met alleen de jar -->
                    <delete dir="${project.build.directory}/jpackage-input" quiet="true"/>
                    <!-- jlink maakt bestanden in de runtime alleen-lezen; Ant's delete kan die op Windows niet verwijderen -->
                    <exec executable="cmd" osfamily="windows" failonerror="false">
                      <arg value="/c"/>
                      <arg value="if exist &quot;${project.build.directory}\app-image&quot; rmdir /s /q &quot;${project.build.directory}\app-image&quot;"/>
                    </exec>
                    <fail message="Kan ${project.build.directory}/app-image niet verwijderen. Is IJC_UI2.exe uit die map nog gestart?">
                      <condition>
                        <available file="${project.build.directory}/app-image"/>
                      </condition>
                    </fail>
                    <copy file="${project.build.directory}/${project.build.finalName}.jar"
                          todir="${project.build.directory}/jpackage-input"/>

                    <exec executable="${java.home}/bin/jpackage" failonerror="true">
                      <arg value="--type"/><arg value="app-image"/>
                      <arg value="--name"/><arg value="IJC_UI2"/>
                      <arg value="--app-version"/><arg value="${project.version}"/>
                      <arg value="--vendor"/><arg value="Lars Dam"/>
                      <arg value="--description"/><arg value="IJC Indeling Interne Jeugd Competitie"/>
                      <arg value="--copyright"/><arg value="GPL v3 - Leo van der Meulen en Lars Dam"/>
                      <arg value="--input"/><arg value="${project.build.directory}/jpackage-input"/>
                      <arg value="--main-jar"/><arg value="${project.build.finalName}.jar"/>
                      <arg value="--main-class"/><arg value="nl.amity.ijc_ui.IJC_Wedstrijden"/>
                      <arg value="--add-modules"/><arg value="${jpackage.modules}"/>
                      <arg value="--jlink-options"/><arg value="--strip-debug --no-header-files --no-man-pages --strip-native-commands --include-locales=nl,en"/>
                      <arg value="--dest"/><arg value="${project.build.directory}/app-image"/>
                    </exec>

                    <!-- jpackage/jlink maken bestanden alleen-lezen. Dat kenmerk weghalen, anders faalt
                         'mvn clean' en komen er alleen-lezen bestanden in de installatie (lastig bij updates). -->
                    <exec executable="cmd" osfamily="windows" failonerror="true">
                      <arg value="/c"/>
                      <arg value="attrib -R &quot;${project.build.directory}\app-image\*&quot; /S /D"/>
                    </exec>

                    <!-- Installers van eerdere versies opruimen (die staan bij GitHub Releases) -->
                    <mkdir dir="${project.basedir}/Release"/>
                    <delete failonerror="false" quiet="true">
                      <fileset dir="${project.basedir}/Release" includes="IJC_UI2-setup-*.exe"/>
                    </delete>

                    <exec executable="${iscc.exe}" failonerror="true">
                      <arg value="/Q"/>
                      <arg value="/DAppVersion=${project.version}"/>
                      <arg value="/DAppImage=${project.build.directory}/app-image/IJC_UI2"/>
                      <arg value="/DOutputDir=${project.basedir}/Release"/>
                      <arg value="/DProjectDir=${project.basedir}"/>
                      <arg value="${project.basedir}/installer/IJC_UI2.iss"/>
                    </exec>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>