<project xmlns="http://maven.apache.org/POM/4.0.0" 
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>nl.amity</groupId>
  <artifactId>ijc_ui</artifactId>
  <version>2.0.1.7</version>
  <packaging>jar</packaging>

  <name>IJC_UI</name>
  <description>Interne Jeugd Competitie UI</description> 

  <repositories>
    <repository>
      <id>objectdb</id>
      <name>ObjectDB Repository</name>
      <url>https://m2.objectdb.com</url>
    </repository>
  </repositories>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.apache.groovy</groupId>
      <artifactId>groovy</artifactId>
      <version>4.0.24</version>
    </dependency>
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>2.11.0</version>
    </dependency>
    <dependency>
      <groupId>org.jfree</groupId>
      <artifactId>jfreechart</artifactId>
      <version>1.5.6</version>
    </dependency>
    <dependency>
      <groupId>org.jfree</groupId>
      <artifactId>jcommon</artifactId>
      <version>1.0.24</version>
    </dependency>
    <dependency>
      <groupId>nz.ac.waikato.cms.weka</groupId>
      <artifactId>weka-stable</artifactId>
      <version>3.8.6</version>
    </dependency>
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi</artifactId>
      <version>5.4.1</version>
    </dependency>
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <version>5.4.1</version>
    </dependency>
    <dependency>
      <groupId>com.objectdb</groupId>
      <artifactId>objectdb</artifactId>
      <version>2.9.0</version>
    </dependency>
    <dependency>
      <groupId>org.json</groupId>
      <artifactId>json</artifactId>
      <version>20240303</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <!-- version.properties krijgt het versienummer uit deze pom (enige bron voor de versie) -->
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>version.properties</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>version.properties</exclude>
        </excludes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <source>${maven.compiler.source}</source>
          <target>${maven.compiler.target}</target>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.3.0</version>
        <configuration>
          <archive>
            <manifest>
              <addClasspath>true</addClasspath>
              <mainClass>nl.amity.ijc_ui.IJC_Wedstrijden</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
         <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>nl.amity.ijc_ui.IJC_Wedstrijden</mainClass>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <version>3.1.0</version>
            <executions>
              <execution>
                <id>create-release-bundle</id>
                <phase>package</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <target>
                    <!-- Ensure Release directory exists -->
                    <mkdir dir="${project.basedir}/Release"/>

                    <!-- Copy the shaded executable JAR -->
                    <copy file="${project.build.directory}/${project.build.finalName}.jar" 
                          tofile="${project.basedir}/Release/${project.artifactId}-${project.version}.jar"/>

                    <!-- Copy template document if present -->
                    <copy file="${project.basedir}/Leeg.docx" 
                          todir="${project.basedir}/Release" 
                          failonerror="false"/>

                    <!-- Generate release metadata file with Java & version details -->
                    <echo file="${project.basedir}/Release/release-info.txt" append="false">Release Version: ${project.version}
Artifact: ${project.artifactId}-${project.version}.jar
Target Java Version: Java ${maven.compiler.target} (Minimum required JRE: ${maven.compiler.target}+)
Build Date: ${maven.build.timestamp}
Main Class: nl.amity.ijc_ui.IJC_Wedstrijden
</echo>

                    <!-- Generate Windows launcher script -->
                    <echo file="${project.basedir}/Release/IJC_UI.cmd" append="false">@echo off
rem Launcher for ${project.name} v${project.version} (Requires Java ${maven.compiler.target}+)
start javaw -jar "%~dp0${project.artifactId}-${project.version}.jar"
</echo>

                    <!-- Create distribution zip archive with all release artifacts -->
                    <zip destfile="${project.basedir}/Release/${project.artifactId}-${project.version}.zip">
                      <fileset dir="${project.basedir}/Release">
                        <include name="${project.artifactId}-${project.version}.jar"/>
                        <include name="release-info.txt"/>
                        <include name="IJC_UI.cmd"/>
                        <include name="Leeg.docx"/>
                      </fileset>
                      <!-- configuratie.json en status.json bevatten clubgegevens en worden niet meegeleverd -->
                      <fileset dir="${project.basedir}">
                        <include name="logging.properties"/>
                        <include name="README.md"/>
                        <include name="CHANGELOG.md"/>
                      </fileset>
                    </zip>

                    <!-- Controle: release mag nooit club- of spelersgegevens bevatten (de repository is openbaar) -->
                    <fail message="Release bevat club- of spelersgegevens (configuratie.json, status.json, keystore, spelersdatabase of rondemap). Release afgebroken.">
                      <condition>
                        <or>
                          <resourcecount when="greater" count="0">
                            <zipfileset src="${project.basedir}/Release/${project.artifactId}-${project.version}.zip"
                                        includes="**/configuratie*.json **/status*.json **/*.ks **/*.odb **/db/** **/R*-*/**"/>
                          </resourcecount>
                          <resourcecount when="greater" count="0">
                            <zipfileset src="${project.build.directory}/${project.build.finalName}.jar"
                                        includes="configuratie*.json status*.json **/*.ks **/*.odb db/**"/>
                          </resourcecount>
                        </or>
                      </condition>
                    </fail>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>